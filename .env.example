# =====================================================================================
#  Enterprise Multi-Commodity Power & Gas Pricing & Imbalance Engine - configuración
#  Copiar a `.env` en la raíz del repositorio:  cp .env.example .env
# =====================================================================================

# --- Modo de ejecución ---------------------------------------------------------------
# true  -> genera mercado sintético realista (no requiere red ni token)
# false -> conecta a REE ESIOS y MIBGAS; si fallan, cae a sintético (salvo INGESTION_STRICT)
MOCK_DATA=true
INGESTION_STRICT=false
MARKET_YEAR=2025
RANDOM_SEED=42
MARKET_TIMEZONE=Europe/Madrid
WAREHOUSE_DIR=data/warehouse
# Máximo de horas imputadas (interpolación) permitido por serie ESIOS antes de rechazar la fuente
MAX_IMPUTED_RATIO=0.01
# Inicio de la operación reforzada de REE (encarece los servicios de ajuste en el modo sintético)
REINFORCED_OPERATION_START=2025-04-28

# --- REE ESIOS (electricidad) ----------------------------------------------------------
# Token personal: solicitar a consultasios@ree.es
ESIOS_API_TOKEN=
ESIOS_BASE_URL=https://api.esios.ree.es
# Geografía del spot (3 = España) y de desvíos/servicios de ajuste (8741 = Península, la única que publica ESIOS)
ESIOS_GEO_ID=3
ESIOS_GEO_ID_SYSTEM=8741
ESIOS_INDICATOR_SPOT=600
ESIOS_INDICATOR_IMBALANCE_UP=686
ESIOS_INDICATOR_IMBALANCE_DOWN=687
# Componentes de servicios de ajuste (se suman por bloque; lista separada por comas)
ESIOS_ANCILLARY_CONSTRAINTS_IDS=807,808,809
ESIOS_ANCILLARY_RESERVES_IDS=810,811
ESIOS_ANCILLARY_OTHER_IDS=813,814,815
ESIOS_CHUNK_DAYS=21
ESIOS_TIMEOUT_S=30
ESIOS_MAX_RETRIES=3

# --- MIBGAS (gas natural) --------------------------------------------------------------
MIBGAS_URL_TEMPLATE=https://www.mibgas.es/es/file-access/MIBGAS_Data_{year}.xlsx?path=AGNO_{year}/XLS
MIBGAS_PRODUCT_CODE=GDAES_D+1
MIBGAS_AREA=PVB
MIBGAS_TIMEOUT_S=60
MIBGAS_MAX_RETRIES=3
MIBGAS_MAX_GAP_DAYS=4
# Ajuste menor de las tarifas de desbalance Enagás (compra = ref x (1+a), venta = ref x (1-a)).
# Resolución CNMC de 1 de julio de 2020: 3 %.
GAS_IMBALANCE_SMALL_ADJUSTMENT=0.03

# --- API REST (Fase 4) ------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por comas (dashboard Next.js)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Parámetros de pricing configurables (ver backend/app/core/regulated.py y GET /api/v1/regulatory/parameters) ---
# Descomenta solo lo que quieras sobrescribir; los valores por defecto son los documentados en el README.
# Aportación al FNEE por MWh vendido. Por defecto, la referencia del PVPC (Orden TED/133/2026).
# PRICING_FNEE_EUR_MWH=2.4374639
# PRICING_GAS_FNEE_EUR_MWH=2.4374639
# Cuota del GTS sobre peajes gasistas, en tanto por uno (1,354 % en el año de gas 2026).
# PRICING_GAS_GTS_QUOTA=0.01354
# Mermas de gas entre el PVB y el contador, en tanto por uno.
# PRICING_GAS_SHRINKAGE_RATIO=0.005
